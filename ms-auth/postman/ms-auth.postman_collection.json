    "name": "ms-auth madera mineria",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleccion de pruebas para el microservicio ms-auth."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@madera.com"
    },
    {
      "key": "adminPassword",
      "value": "admin123"
    },
    {
      "key": "comprasEmail",
      "value": "compras@cerroverde.com"
    },
    {
      "key": "comprasPassword",
      "value": "compras123"
    },
    {
      "key": "almacenEmail",
      "value": "almacen@madera.com"
    },
    {
      "key": "almacenPassword",
      "value": "almacen123"
    },
    {
      "key": "transporteEmail",
      "value": "transporte@madera.com"
    },
    {
      "key": "transportePassword",
      "value": "trans123"
    },
    {
      "key": "userId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Registrar ADMIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Mamani\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"rol\": \"ROLE_ADMIN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 o 400', function () {",
              "    pm.expect([201, 400]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const data = pm.response.json();",
              "    if (data.token) {",
              "        pm.collectionVariables.set('token', data.token);",
              "    }",
              "}"
            ]
          }
        }
      ]
    },
